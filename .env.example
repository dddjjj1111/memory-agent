# Offline keyword heuristic. Set to 0 to call an OpenAI-compatible chat API.
USE_MOCK_LLM=1

# Used only when USE_MOCK_LLM=0.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# JSON memory files. Relative paths resolve from the working directory.
MEMORY_DIR=data/memory

# Model decisions per user turn, including the final answer.
MAX_STEPS=6
